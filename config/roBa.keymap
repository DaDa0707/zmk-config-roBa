#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&none  &kp LEFT_SHIFT    &kp F  &kp J          &kp P                                             &kp G        &kp Z  &kp D  &kp X  &none
&none  &kp LEFT_CONTROL  &kp U  &kp I          &kp A        &kp V                 &kp C          &kp K        &kp S  &kp T  &kp N  &none
&none  &kp MINUS         &kp W  &kp O          &kp E        &kp B                 &kp Q          &kp H        &kp M  &kp Y  &kp R  &none
&none  &kp COMMA         &kp L  &kp LC(SPACE)  &lt 1 SPACE  &kp LEFT_COMMAND      &kp BACKSPACE  &lt 2 ENTER                       &none
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        Nuber {
            bindings = <
&none  &kp LEFT_BRACE  &kp RIGHT_BRACE    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS                                         &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PLUS      &none
&none  &kp PIPE        &kp HASH           &kp AMPERSAND         &kp DOLLAR             &kp PERCENT          &kp KP_NUMBER_0   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp MINUS     &none
&none  &kp SEMI        &kp SQT            &kp SLASH             &kp AT_SIGN            &kp EXCLAMATION      &kp EQUAL         &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp ASTERISK  &none
&none  &kp COLON       &kp DOUBLE_QUOTES  &none                 &none                  &kp SPACE            &kp LEFT_CONTROL  &kp QUESTION                                                     &none
            >;
        };

        ARROW {
            bindings = <
&none   &bt BT_SEL 0            &kp LC(LS(TAB))          &kp UP              &kp LC(TAB)                                           &none      &trans                &trans       &trans  &trans
&none   &bt BT_SEL 1            &kp LEFT_ARROW           &kp DOWN_ARROW      &kp RIGHT_ARROW   &kp RG(C)                &kp RG(C)  &kp RG(V)  &mkp MB1              &mkp MB2     &trans  &trans
&none   &kp LG(LS(LEFT_ARROW))  &kp LG(LS(RIGHT_ARROW))  &kp LC(LEFT_ARROW)  &kp LC(UP_ARROW)  &kp LC(RIGHT_ARROW)      &kp RG(X)  &kp RG(Z)  &kp RG(RS(NUMBER_3))  &kp RG(TAB)  &none   &trans
&trans  &trans                  &trans                   &trans              &trans            &trans                   &trans     &trans                                                &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };
    };
};
